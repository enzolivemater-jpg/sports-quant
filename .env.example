# F1 development defaults only. Do not place real credentials in this file.
SPORTS_QUANT_ENV=local
SPORTS_QUANT_LOG_LEVEL=INFO
SPORTS_QUANT_OTEL_SERVICE_NAME=sports-quant

POSTGRES_USER=sports_quant
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=sports_quant
POSTGRES_PORT=5432
SPORTS_QUANT_DATABASE_URL=postgresql+psycopg://sports_quant:local_dev_only_change_me@localhost:5432/sports_quant

POSTGRES_TEST_USER=sports_quant_test
POSTGRES_TEST_PASSWORD=local_test_only_change_me
POSTGRES_TEST_DB=sports_quant_test
POSTGRES_TEST_PORT=5433
SPORTS_QUANT_TEST_DATABASE_URL=postgresql+psycopg://sports_quant_test:local_test_only_change_me@localhost:5433/sports_quant_test
